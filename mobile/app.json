{
  "expo": {
    "name": "CargoConnect",
    "slug": "cargoconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cargoconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ma.cargoconnect.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ma.cargoconnect.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1B2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "CargoConnect utilise Face ID pour déverrouiller votre session."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CargoConnect utilise Face ID pour déverrouiller votre session."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CargoConnect a besoin d'accéder à vos photos pour illustrer vos annonces.",
          "cameraPermission": "CargoConnect a besoin de l'appareil photo pour photographier la marchandise."
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CargoConnect enregistre votre position au chargement et à la livraison, comme preuve du transport."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true
    }
  }
}
