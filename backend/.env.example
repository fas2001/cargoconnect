# Copier en .env (ou définir dans l'environnement du serveur)
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# PostgreSQL (docker compose up -d db). Sans cette variable : SQLite local.
DATABASE_URL=postgres://cargoconnect:cargoconnect@localhost:5432/cargoconnect
# Règles métier
REQUIRE_VERIFIED_DRIVER_TO_OFFER=true
DELIVERY_AUTO_CONFIRM_HOURS=48
# Codes de vérification : console en dev (code affiché dans le terminal), WhatsApp en production.
OTP_BACKEND=apps.accounts.otp_delivery.ConsoleBackend
# OTP_BACKEND=apps.accounts.otp_delivery.WhatsAppCloudBackend
# Identifiants WhatsApp Cloud API (voir docs/whatsapp.md) — ne jamais les committer
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=cargoconnect_code
WHATSAPP_TEMPLATE_LANGUAGE=fr
EXPO_PUSH_ENABLED=false
